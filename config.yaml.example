# Sample configuration file for Smite 2 Random Conquest Bot
# Copy this to config.yaml and fill in your values

# Discord bot token (can also be set via DISCORD_BOT_TOKEN environment variable)
# token: "your-discord-bot-token-here"

# Guild-specific configurations
guilds:
  # Replace with your Discord server ID
  # "123456789012345678":
  #   guild_id: "123456789012345678"
  #   allowed_channel: "987654321098765432"  # Optional: restrict commands to this channel

# Example configuration:
# guilds:
#   "987654321098765432":
#     guild_id: "987654321098765432"
#     # allowed_channel: "123456789012345678"  # Uncomment to restrict to specific channel